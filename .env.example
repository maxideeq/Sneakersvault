# Server
PORT=3000
SITE_URL=http://localhost:3000

# Seller / admin account (used on first run to create the dashboard login)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-now
SELLER_EMAIL=orders@solesociety.se

# Optional SMTP for order confirmation + seller notification emails.
# If unset, every email is written to data/outbox.log instead (nothing is lost).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Sole Society <no-reply@solesociety.se>"
SMTP_SECURE=false
